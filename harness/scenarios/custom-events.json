{
  "name": "custom-events",
  "projectId": "proj_HARNESS00000000000000000000",
  "options": {},
  "expectPublishes": 13,
  "sessions": [
    {
      "steps": [
        { "op": "callTool", "name": "echo", "args": { "msg": "start" }, "saveHandleAs": "S1" },
        { "op": "callTool", "name": "emit_custom", "args": { "session": "${S1}", "resource": "string-form", "message": "with a session", "session_id": "${S1}" } },
        { "op": "callTool", "name": "emit_custom", "args": { "session": "", "resource": "string-form-no-session", "message": "without a session", "session_id": "${S1}" } },
        { "op": "callTool", "name": "emit_custom_server", "args": { "session": "${S1}", "resource": "server-form", "message": "with a session", "session_id": "${S1}" } },
        { "op": "callTool", "name": "emit_custom_server", "args": { "resource": "server-form-no-session", "message": "without a session", "session_id": "${S1}" } },
        { "op": "callTool", "name": "emit_custom_server", "args": { "session": "${S1}", "resource": "server-form-tags", "tags": { "bad key!": "dropped", "abcdefghijklmnopqrstuvwxyz0123456": "dropped", "count": 5, "multi": "line\nbreak", "kind": "custom" }, "session_id": "${S1}" } },
        { "op": "callTool", "name": "emit_custom_server", "args": { "session": "${S1}", "resource": "server-form-no-valid-tag", "tags": { "count": 5 }, "session_id": "${S1}" } }
      ]
    }
  ]
}
