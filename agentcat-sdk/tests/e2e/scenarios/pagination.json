{
  "projectId": "proj_E2E000000000000000000000000",
  "options": {},
  "pageSize": 3,
  "expectPublishes": 5,
  "sessions": [
    {
      "client": { "name": "e2e-client", "version": "1.0.0" },
      "steps": [
        { "op": "listTools", "saveCursorAs": "PAGE2" },
        { "op": "callTool", "name": "echo", "args": { "msg": "page one", "context": "Listing the first page" }, "saveHandleAs": "S1" },
        { "op": "callTool", "name": "big", "args": { "size": 3, "session_id": "${S1}", "context": "A page-2 tool before page 2 is listed" } },
        { "op": "listTools", "cursor": "${PAGE2}", "saveCursorAs": "PAGE3" },
        { "op": "callTool", "name": "big", "args": { "size": 3, "session_id": "${S1}", "context": "The same tool after page 2 is listed" } },
        { "op": "listTools", "cursor": "${PAGE3}" },
        { "op": "callTool", "name": "own_context", "args": { "context": "the tool's own context", "session_id": "${S1}" } },
        { "op": "callTool", "name": "echo", "args": { "msg": "page one again", "session_id": "${S1}" } }
      ]
    }
  ]
}
