{
  "projectId": "proj_HARNESS00000000000000000000",
  "options": {
    "enableReportMissing": false,
    "enableToolCallContext": false
  },
  "httpHeaders": { "x-test-header": "harness" },
  "expectPublishes": 6,
  "sessions": [
    {
      "client": { "name": "harness-client-off", "version": "1.0.0" },
      "steps": [
        { "op": "listTools" },
        { "op": "callTool", "name": "echo", "args": { "msg": "issue a handle" }, "saveHandleAs": "S1" },
        { "op": "callTool", "name": "echo", "args": { "msg": "a context that is not ours", "session_id": "${S1}", "context": "Not injected, so not stripped" } },
        { "op": "callTool", "name": "structured", "args": { "msg": "s", "session_id": "${S1}" } },
        { "op": "callTool", "name": "own_context", "args": { "context": "The tool's own context argument", "session_id": "${S1}" } },
        { "op": "callTool", "name": "boom", "args": { "session_id": "${S1}" } },
        { "op": "callTool", "name": "get_more_tools", "args": { "context": "Report-missing is off" } }
      ]
    }
  ]
}
