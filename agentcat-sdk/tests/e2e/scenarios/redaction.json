{
  "projectId": "proj_E2E000000000000000000000000",
  "options": {
    "identify": { "returns": { "userId": "user-late", "userName": "Late User", "userData": { "plan": "late" } }, "sleep_ms": 200 },
    "event_tags": { "returns": { "note": "SECRET_TOKEN" } },
    "event_properties": { "returns": { "region": "SECRET_TOKEN" } },
    "redact_sensitive_information": { "replace": "SECRET_TOKEN" },
    "redact_event": { "merge": { "resourceName": "renamed", "sessionId": "merged-session", "properties": { "merged": "yes" } } }
  },
  "expectPublishes": 7,
  "sessions": [
    {
      "client": { "name": "e2e-client", "version": "1.0.0" },
      "steps": [
        { "op": "listTools" },
        { "op": "callTool", "name": "echo", "args": { "msg": "first SECRET_TOKEN", "context": "Checking that SECRET_TOKEN leaves the process redacted" }, "saveHandleAs": "S1" },
        { "op": "callTool", "name": "echo", "args": { "msg": "again SECRET_TOKEN", "session_id": "${S1}" } },
        { "op": "callTool", "name": "boom", "args": { "session_id": "${S1}" } },
        { "op": "callTool", "name": "emit_custom", "args": { "session": "${S1}", "resource": "checkout", "message": "custom SECRET_TOKEN", "session_id": "${S1}" } },
        { "op": "callTool", "name": "emit_custom_server", "args": { "session": "${S1}", "resource": "server-side", "message": "server SECRET_TOKEN", "session_id": "${S1}" } }
      ]
    }
  ]
}
